local function parsePts(s)
    local pts = {}
    for part in s:gmatch("[^,]+") do
        local x, y, c = part:match("^(%d+)|(%d+)|(%x%x%x%x%x%x)")
        pts[#pts+1] = { x = tonumber(x), y = tonumber(y), c = c }
    end
    return pts
end

local function rgbOf(c) -- BBGGRR 字符串 -> r,g,b
    local b = tonumber(c:sub(1, 2), 16)
    local g = tonumber(c:sub(3, 4), 16)
    local r = tonumber(c:sub(5, 6), 16)
    return r, g, b
end

