<窗口
	宽度="680"
	高度="760"
	显示确认按钮="true"
	显示标题栏="true"
	标题="SAOIF 自动助手"
	配置文件="saoif.config"
	标签头高度="44"
	标签头背景="#fff2f4f8"
	标签头字体大小="15"
	标签头选中字体颜色="#ff007aff"
	标签头字体默认颜色="#ff888888">

	<!-- ==================== 标签页1：功能选择 ==================== -->
	<标签页 标题="功能选择" 背景="#ffffffff">
		<垂直布局 宽度="-1" 高度="-1" 背景="#ffffffff" 内边距="16,20,16,16">
			<文本框 文本="① 选择要运行的功能" 字体大小="17" 字体颜色="#ff222222" 宽度="-1" 高度="36"/>
			<文本框 文本="启动前必须先选择一个功能，点击底部【继续】按钮开始运行" 字体大小="12" 字体颜色="#ff999999" 宽度="-1" 高度="28"/>

			<水平布局 宽度="-1" 高度="-1" 背景="#00ffffff" 边距="0,8,0,0">
				<文本框 文本="运行功能" 字体大小="15" 字体颜色="#ff444444" 宽度="110" 高度="52"/>
				<下拉框 id="selFunction" 宽度="-1" 默认值="0">
					<选项 文本="钓鱼"/>
				</下拉框>
			</水平布局>

			<文本框 文本="【功能说明】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32" 边距="0,20,0,0"/>
			<文本框 id="lblDesc" 文本="自动钓鱼：识别钓场状态栏（开始/提竿/命中），自动追踪完美区域并提竿，循环钓鱼并统计次数。&#10;&#10;· 分辨率基准：1280x720&#10;· 相关坐标参数请到【钓鱼设置】页调整&#10;· 后续新功能会加入此列表中" 字体大小="13" 字体颜色="#ff666666" 宽度="-1" 高度="170"/>

			<文本框 文本="提示：底部【继续】= 保存配置并运行，【退出】= 结束脚本" 字体大小="12" 字体颜色="#ffff9500" 宽度="-1" 高度="30" 边距="0,20,0,0"/>
		</垂直布局>
	</标签页>

	<!-- ==================== 标签页2：钓鱼设置 ==================== -->
	<标签页 标题="钓鱼设置" 背景="#ffffffff">
		<垂直布局 宽度="-1" 高度="-1" 背景="#ffffffff" 内边距="16,20,16,16">
			<文本框 文本="【运行参数】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32"/>
			<水平布局 宽度="-1" 高度="52" 背景="#00ffffff">
				<文本框 文本="单轮超时(秒)" 字体大小="14" 字体颜色="#ff444444" 宽度="140" 高度="-1"/>
				<输入框 id="edLoopTime" 输入类型="1" 默认值="45" 宽度="90" 高度="-1"/>
				<文本框 文本="无操作多久后结束(成功会重置)" 字体大小="11" 字体颜色="#ff999999" 宽度="-1" 高度="-1" 边距="10,0,0,0"/>
			</水平布局>
			<水平布局 宽度="-1" 高度="52" 背景="#00ffffff">
				<文本框 文本="目标次数" 字体大小="14" 字体颜色="#ff444444" 宽度="140" 高度="-1"/>
				<输入框 id="edMaxCatch" 输入类型="1" 默认值="0" 宽度="90" 高度="-1"/>
				<文本框 文本="达到后停止，0 = 不限制" 字体大小="11" 字体颜色="#ff999999" 宽度="-1" 高度="-1" 边距="10,0,0,0"/>
			</水平布局>

			<文本框 文本="【坐标配置】(基准 1280x720)" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32" 边距="0,12,0,0"/>
			<水平布局 宽度="-1" 高度="52" 背景="#00ffffff">
				<文本框 文本="操作按钮X" 字体大小="14" 字体颜色="#ff444444" 宽度="140" 高度="-1"/>
				<输入框 id="edClickX" 输入类型="1" 默认值="1173" 宽度="70" 高度="-1"/>
				<文本框 文本="Y" 字体大小="14" 字体颜色="#ff444444" 宽度="24" 高度="-1" 边距="12,0,0,0"/>
				<输入框 id="edClickY" 输入类型="1" 默认值="510" 宽度="70" 高度="-1"/>
				<文本框 文本="开始/提竿按钮坐标" 字体大小="11" 字体颜色="#ff999999" 宽度="-1" 高度="-1" 边距="10,0,0,0"/>
			</水平布局>
			<水平布局 宽度="-1" 高度="52" 背景="#00ffffff">
				<文本框 文本="扫描列X" 字体大小="14" 字体颜色="#ff444444" 宽度="140" 高度="-1"/>
				<输入框 id="edScanX" 输入类型="1" 默认值="1015" 宽度="70" 高度="-1"/>
				<文本框 文本="Y1" 字体大小="14" 字体颜色="#ff444444" 宽度="30" 高度="-1" 边距="6,0,0,0"/>
				<输入框 id="edZoneY1" 输入类型="1" 默认值="123" 宽度="62" 高度="-1"/>
				<文本框 文本="Y2" 字体大小="14" 字体颜色="#ff444444" 宽度="30" 高度="-1" 边距="6,0,0,0"/>
				<输入框 id="edZoneY2" 输入类型="1" 默认值="523" 宽度="62" 高度="-1"/>
			</水平布局>
			<文本框 文本="扫描列/Y1/Y2 用于检测完美区域与浮标位置" 字体大小="11" 字体颜色="#ff999999" 宽度="-1" 高度="26"/>

			<文本框 文本="【高级选项】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32" 边距="0,12,0,0"/>
			<多选框 id="chkShowHud" 选中="true" 文本="屏幕显示运行状态 HUD" 字体大小="14"/>
			<多选框 id="chkDebugColors" 选中="false" 文本="启动时输出颜色采样调试信息" 字体大小="14"/>
		</垂直布局>
	</标签页>

	<!-- ==================== 标签页3：使用说明 ==================== -->
	<标签页 标题="使用说明" 背景="#ffffffff">
		<垂直布局 宽度="-1" 高度="-1" 背景="#ffffffff" 内边距="16,20,16,16">
			<文本框 文本="【使用流程】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32"/>
			<文本框 文本="1. 进入游戏的钓鱼界面，让钓场状态栏可见&#10;2. 在【功能选择】页选择要运行的功能&#10;3. 按需在【钓鱼设置】页调整参数&#10;4. 点击底部【继续】按钮，界面关闭后自动开始运行&#10;5. 运行中可通过 IDE 输出面板查看日志，悬浮按钮可随时停止" 字体大小="13" 字体颜色="#ff555555" 宽度="-1" 高度="180"/>

			<文本框 文本="【注意事项】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32"/>
			<文本框 文本="· 所有坐标基于 1280x720 分辨率，其他分辨率请自行换算或开启缩放&#10;· 保持屏幕常亮，勿遮挡游戏窗口&#10;· 结算图片资源(资源/fishing_clone.png)可选，存在时成功后自动点击继续" 字体大小="13" 字体颜色="#ff555555" 宽度="-1" 高度="140"/>

			<文本框 文本="【项目结构】" 字体大小="14" 字体颜色="#ff007aff" 宽度="-1" 高度="32"/>
			<文本框 文本="脚本/saoif.lua        主入口：界面 + 功能分发&#10;脚本/core/dispatcher.lua  功能注册表&#10;脚本/core/pixel.lua       比色/像素工具&#10;脚本/core/logger.lua      日志&#10;脚本/tasks/fishing.lua    钓鱼功能" 字体大小="12" 字体颜色="#ff888888" 宽度="-1" 高度="140"/>
		</垂直布局>
	</标签页>
</窗口>
