local logger = require("core.logger")
local pixel = require("core.pixel")
local dispatcher = require("core.dispatcher")

local M = { name = "钓鱼" }

-- ============ 特征点定义 {x, y, "RRGGBB"}（来自原 Python 项目特征库） ============

