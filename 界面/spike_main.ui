<窗口
	宽度="560"
	高度="660"
	显示确认按钮="true"
	显示标题栏="true"
	标题="框架探针"
	配置文件="spike_main.config"
	标签头高度="-2">

	<标签页 标题="探针" 背景="#fff2f4f8">
		<垂直布局 宽度="-1" 高度="-1" 背景="#fff2f4f8">

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="① 假设验证结果" 字体大小="16" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<文本框 id="lblReport" 文本="运行后此处显示汇总" 字体大小="12" 字体颜色="#ff666666" 宽度="-1" 高度="-2" 边距="0,6,0,0"/>
			</垂直布局>

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="② 窗口循环：主界面 → 参数页 → 返回" 字体大小="16" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<水平布局 宽度="-1" 高度="-2" 背景="#00ffffff" 边距="0,10,0,0">
					<文本框 文本="任务" 字体大小="15" 字体颜色="#ff333333" 宽度="-2" 高度="56"/>
					<下拉框 id="selTask" 宽度="-1" 高度="56" 默认值="0" 边距="12,0,0,0">
						<选项 文本="钓鱼"/>
						<选项 文本="每日任务"/>
						<选项 文本="公告板"/>
					</下拉框>
				</水平布局>
				<按钮 id="btnConfig" 文本="配置选中任务的参数" 字体大小="15" 宽度="-1" 高度="64" 边距="0,10,0,0"/>
				<文本框 文本="底部【继续】= 开始运行　【退出】= 结束脚本" 字体大小="12" 字体颜色="#ffff9500" 宽度="-1" 高度="-2" 边距="0,10,0,0"/>
			</垂直布局>

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="③ 到期调度器（模拟数据）" 字体大小="16" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<文本框 id="lblSched" 文本="—" 字体大小="13" 字体颜色="#ff555555" 宽度="-1" 高度="-2" 边距="0,6,0,0"/>
			</垂直布局>

		</垂直布局>
	</标签页>
</窗口>
