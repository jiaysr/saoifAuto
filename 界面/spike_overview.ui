<窗口
	宽度="640"
	高度="900"
	显示确认按钮="true"
	显示标题栏="true"
	标题="SAOIF 自动助手（界面探针）"
	配置文件="spike_overview.config">

	<!-- ============ 标签页1：总览（启用任务，按下次运行时间排序） ============ -->
	<标签页 标题="总览" 背景="#fff2f4f8">
		<垂直布局 宽度="-1" 高度="-1" 背景="#fff2f4f8">

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="启用的任务（按下次运行时间排序）" 字体大小="15" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<文本框 id="lblOvSummary" 文本="—" 字体大小="12" 字体颜色="#ff999999" 宽度="-1" 高度="-2" 边距="0,4,0,0"/>
				<按钮 id="btnRow0" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow1" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow2" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow3" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow4" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow5" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow6" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnRow7" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<文本框 id="lblOvEmpty" 文本="" 字体大小="13" 字体颜色="#ff999999" 宽度="-1" 高度="-2" 边距="0,10,0,0"/>
			</垂直布局>

		</垂直布局>
	</标签页>

	<!-- ============ 标签页2：配置（全部任务） ============ -->
	<标签页 标题="配置" 背景="#fff2f4f8">
		<垂直布局 宽度="-1" 高度="-1" 背景="#fff2f4f8">

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="全部任务（点击进入该任务配置页）" 字体大小="15" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<文本框 id="lblCfgSummary" 文本="—" 字体大小="12" 字体颜色="#ff999999" 宽度="-1" 高度="-2" 边距="0,4,0,0"/>
				<按钮 id="btnAll0" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll1" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll2" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll3" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll4" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll5" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll6" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
				<按钮 id="btnAll7" 文本="" 字体大小="14" 宽度="-1" 高度="56" 边距="0,8,0,0"/>
			</垂直布局>

		</垂直布局>
	</标签页>

	<!-- ============ 标签页3：全局配置 ============ -->
	<标签页 标题="全局" 背景="#fff2f4f8">
		<垂直布局 宽度="-1" 高度="-1" 背景="#fff2f4f8">

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="运行" 字体大小="15" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<多选框 id="chkGlobalHud" 选中="true" 文本="显示运行状态 HUD" 字体大小="14" 宽度="-1" 高度="-2" 边距="0,10,0,0"/>
				<水平布局 宽度="-1" 高度="-2" 背景="#00ffffff" 边距="0,10,0,0">
					<文本框 文本="最大连续失败次数" 字体大小="15" 字体颜色="#ff333333" 宽度="-2" 高度="56"/>
					<输入框 id="edMaxFail" 输入类型="1" 默认值="3" 宽度="120" 高度="56" 边距="12,0,0,0"/>
				</水平布局>
				<文本框 文本="超过后停止脚本，等待人工介入" 字体大小="12" 字体颜色="#ff999999" 宽度="-1" 高度="-2" 边距="0,4,0,0"/>
			</垂直布局>

			<垂直布局 宽度="-1" 高度="-2" 背景="#ffffffff" 边距="12,12,12,0" 内边距="16,12,16,14">
				<文本框 文本="日志" 字体大小="15" 字体颜色="#ff007aff" 宽度="-1" 高度="-2"/>
				<水平布局 宽度="-1" 高度="-2" 背景="#00ffffff" 边距="0,10,0,0">
					<文本框 文本="日志级别" 字体大小="15" 字体颜色="#ff333333" 宽度="-2" 高度="56"/>
					<下拉框 id="selLogLevel" 宽度="-1" 高度="56" 默认值="1" 边距="12,0,0,0">
						<选项 文本="调试"/>
						<选项 文本="信息"/>
						<选项 文本="警告"/>
					</下拉框>
				</水平布局>
				<多选框 id="chkLogToFile" 选中="false" 文本="同时写入设备文件" 字体大小="14" 宽度="-1" 高度="-2" 边距="0,10,0,0"/>
			</垂直布局>

		</垂直布局>
	</标签页>

</窗口>
